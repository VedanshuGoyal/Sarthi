[Unit]
Description=Sarthi Go API server
Documentation=https://github.com/VedanshuGoyal/Sarthi
After=network-online.target postgresql.service
# Wants, not Requires: `postgresql.service` on Debian/Ubuntu is a meta-unit that
# always reports success, so Requires buys nothing but can cascade failures.
# Restart=on-failure below covers the case where Postgres is not ready yet.
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=sarthi
Group=sarthi

# DATABASE_URL, ADDR, FAST2SMS_API_KEY, FAST2SMS_OTP_ID.
# Generated by setup-vps.sh from server/.env.prod; root-owned, mode 0600.
EnvironmentFile=/etc/sarthi/sarthi.env
ExecStart=/opt/sarthi/bin/sarthi-server

Restart=on-failure
RestartSec=2s

# Hardening. The server only needs to listen on a TCP port and reach Postgres —
# it writes nothing to disk, so the filesystem can stay read-only throughout.
# If a future feature needs to write (uploads, on-disk cache), add an explicit
# ReadWritePaths= rather than loosening ProtectSystem=.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
