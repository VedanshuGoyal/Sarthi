# Caddy config for the VPS deployment.
#
# The backend runs as a systemd unit directly on the host, not in a container,
# so the upstream is localhost:8080 rather than a Docker service name.
#
# DOMAIN is read from the environment, so this file stays free of any specific
# hostname. setup-vps.sh writes it to /etc/sarthi/caddy.env and points
# caddy.service at that file via a systemd drop-in.
#
# Caddy handles HTTP->HTTPS redirect, Let's Encrypt issuance/renewal, and
# WebSocket upgrades automatically — none of that needs configuring.
{$DOMAIN} {
	reverse_proxy localhost:8080

	# Access log, so requests are inspectable:
	#   tail -f /var/log/caddy/sarthi.log | jq
	log {
		output file /var/log/caddy/sarthi.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
