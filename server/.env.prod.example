# Production secrets for the VPS deployment (deploy/setup-vps.sh and
# deploy/redeploy.sh read this file) — copy to .env.prod (gitignored) and fill
# in real values. Never commit .env.prod.
#
# For local development on your Mac you want server/.env instead; this file is
# only for the live VPS.

DOMAIN=api.yourdomain.com
POSTGRES_PASSWORD=
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
