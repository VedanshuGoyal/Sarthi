<?xml version="1.0" encoding="utf-8"?>
<!-- The Deep Signal splash canvas, shown from process start until Flutter
     draws its first frame. @color/launch_background carries a `-night`
     variant (see values-night/launch_background.xml), so this one drawable
     covers light and dark alike — matches DeepSignalTokens.canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

