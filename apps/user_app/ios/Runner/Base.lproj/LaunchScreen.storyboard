    </scenes>
    <!-- Both resources are asset-catalog entries with light and dark
         appearances, so this single storyboard brands the MOJUD launch screen
         in either mode: `LaunchBackground.colorset` carries the Deep Signal
         canvas, and `LaunchImage.imageset` the stacked lockup drawn in the
         matching foreground. Regenerate the images with
         `python3 tool/gen_launcher_icons.py`. -->
    <resources>
        <image name="LaunchImage" width="222" height="136"/>
        <namedColor name="LaunchBackground">
            <color red="0.90588235294117647" green="0.94117647058823528" blue="0.97254901960784312" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
