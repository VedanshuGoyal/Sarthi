# Build-time settings for user_app. Copy to `.env` (git-ignored), then run:
#   flutter run --dart-define-from-file=.env
#
# Ola Maps (place search) needs nothing here: the app fetches short-lived tokens
# from the backend (GET /maps/token), which alone holds the Ola client secret —
# set OLA_MAPS_CLIENT_ID / OLA_MAPS_CLIENT_SECRET in server/.env instead.
# Optional override (default in lib/core/config/ola_maps_config.dart):
# OLA_MAPS_BASE_URL=https://api.olamaps.io

# Google Maps SDK key for the "Select on map" pickup step. Unlike the Ola keys
# above (compile-time dart-defines), this one is read by the *native* build:
# Android Gradle injects it into the manifest; on iOS the run script writes it
# into ios/Flutter/Maps.xcconfig. Restrict the key in Google Cloud Console to
# the app (Android package com.sarthi.user_app + your signing SHA-1).
MAPS_API_KEY=
