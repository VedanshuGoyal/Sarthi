# Ola Maps OAuth 2.0 (client-credentials) — used by the pickup-location step.
# Copy to `.env` (git-ignored) and fill in your own credentials, then run:
#   flutter run --dart-define-from-file=.env
OLA_MAPS_CLIENT_ID=
OLA_MAPS_CLIENT_SECRET=
# Optional overrides (sensible defaults in lib/core/config/ola_maps_config.dart):
# OLA_MAPS_BASE_URL=https://api.olamaps.io
# OLA_MAPS_TOKEN_URL=https://account.olamaps.io/realms/olamaps/protocol/openid-connect/token
